    <script>
        var allDocs = [];
        var searchTimer = null;
        var currentTerm = '';

        // URL se detect karo - Dashboard ya MyDocuments
        var isMyDocs = window.location.pathname.toLowerCase().indexOf('mydocuments') !== -1;

        // ---- Load documents on page load ----
        $(document).ready(function () {

            // Active nav link set karo
            if (isMyDocs) {
                $('#navMyDocs').addClass('active');
                $('#navDashboard').removeClass('active');
                $('.topbar-title').text('My Documents');
            } else {
                $('#navDashboard').addClass('active');
                $('#navMyDocs').removeClass('active');
                $('.topbar-title').text('All Documents');
            }

            loadDocuments('');

            $('#searchInput').on('input', function () {
                clearTimeout(searchTimer);
                var term = $(this).val().trim();
                searchTimer = setTimeout(function () {
                    currentTerm = term;
                    loadDocuments(term);
                }, 400);
            });
        });

             function loadDocuments(term) {
            $.ajax({
                url: '@Url.Action("SearchByCategory", "Document")',
                type: 'GET',
                data: { term: term, isMyDocs: isMyDocs },
                success: function (res) {
                    renderTable(res);
                    updateStats(res);
                    $('#searchHint').text(
                        term ? res.length + ' result(s) found' : ''
                    );
                },
                error: function () {
                    showToast('Failed to load documents.', 'error');
                }
            });
        }

        function searchByCategory(term) {
            $.ajax({
                url: '@Url.Action("SearchByCategory", "Document")',
                type: 'GET',
                data: { term: term },
                success: function (data) {
                    renderTable(data);
                    $('#searchHint').text(data.length + ' result(s) found');
                },
                error: function () { showToast('Search failed.', 'error'); }
            });
        }

        function renderTable(docs) {
            var tbody = $('#docTableBody');
            tbody.empty();

            if (!docs || docs.length === 0) {
                tbody.html('<tr><td colspan="6"><div class="empty-state">' +
                    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="width:48px;height:48px;opacity:0.3;display:block;margin:0 auto 10px">' +
                    '<path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>' +
                    '<polyline points="14 2 14 8 20 8"/></svg>' +
                    '<p>No documents found</p></div></td></tr>');
                return;
            }

            docs.forEach(function (d, i) {
                var date = d.EntryDate ? new Date(parseInt(d.EntryDate.replace('/Date(', '').replace(')/', ''))).toLocaleDateString('en-IN') : '-';
                var badgeClass = getBadgeClass(d.DocumentType);
                var row = '<tr>' +
                    '<td style="color:var(--text-muted);font-size:12px;">' + (i + 1) + '</td>' +
                    '<td><div class="doc-name">' + (d.MasterDocumentName || '-') + '</div>' +
                    '<div class="doc-meta">By: ' + (d.EntryBy || '-') + '</div></td>' +
                    '<td><span class="badge badge-blue">' + (d.Topic || '-') + '</span></td>' +
                    '<td><span class="badge ' + badgeClass + '">' + (d.DocumentType || 'General') + '</span></td>' +
                    '<td style="font-size:12.5px;white-space:nowrap;">' + date + '</td>' +
                    '<td><div class="action-btns">' +

                    // View
                    '<button class="btn-icon view" onclick="viewDoc(' + d.EnteryNo + ',\'' + (d.DocumentPath || '') + '\')" title="Preview">' +
                    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/><circle cx="12" cy="12" r="3"/></svg></button>' +

                    // Download
                    '<button class="btn-icon download" onclick="downloadDoc(' + d.EnteryNo + ')" title="Download">' +
                    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg></button>' +

                    // QR Code
                    '<button class="btn-icon qr" onclick="openQR(' + d.EnteryNo + ')" title="Generate QR">' +
                    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="5" height="5"/><rect x="16" y="3" width="5" height="5"/><rect x="3" y="16" width="5" height="5"/><path d="M21 16h-3v3M21 21v.01M16 16v.01M16 21h2"/></svg></button>' +

                    // Delete
                    '<button class="btn-icon delete" onclick="deleteDoc(' + d.EnteryNo + ')" title="Delete">' +
                    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6M14 11v6"/></svg></button>' +

                    '</div></td></tr>';
                tbody.append(row);
            });
        }



        function updateStats(docs) {
            $('#totalDocs').text(docs.length);
            var cats = [...new Set(docs.map(d => d.Topic).filter(Boolean))];
            $('#totalCats').text(cats.length);
            var views = docs.reduce(function (sum, d) { return sum + (d.No_Of_visitors || 0); }, 0);
            $('#totalViews').text(views);
        }

        function getBadgeClass(type) {
            if (!type) return 'badge-gray';
            type = type.toLowerCase();
            if (type.includes('pdf'))    return 'badge-orange';
            if (type.includes('word') || type.includes('doc')) return 'badge-blue';
            if (type.includes('excel') || type.includes('xls')) return 'badge-green';
            if (type.includes('image') || type.includes('img')) return 'badge-purple';
            return 'badge-gray';
        }

        // ---- Category Dropdown ----
        function onCatInput() {
            var term = $('#catInput').val().trim();
            if (term.length === 0) { $('#catDropdown').removeClass('show').empty(); return; }

            $.ajax({
                url: '@Url.Action("GetCategories", "Document")',
                type: 'GET',
                data: { term: term },
                success: function (cats) {
                    var dd = $('#catDropdown');
                    dd.empty();

                    cats.forEach(function (c) {
                        dd.append('<div class="cat-item" onclick="selectCat(\'' + c.CategoryName + '\')">' + c.CategoryName + '</div>');
                    });

                    // Option to add new
                    var exists = cats.some(function (c) { return c.CategoryName.toLowerCase() === term.toLowerCase(); });
                    if (!exists) {
                        dd.append('<div class="cat-item new-cat" onclick="selectCat(\'' + term + '\')">+ Add new: "' + term + '"</div>');
                    }

                    dd.addClass('show');
                }
            });
        }

        function selectCat(name) {
            $('#catInput').val(name);
            $('#catDropdown').removeClass('show').empty();
        }

        // Close dropdown on outside click
        $(document).on('click', function (e) {
            if (!$(e.target).closest('.cat-wrap').length)
                $('#catDropdown').removeClass('show');
        });

        // ---- File Upload ----
        function onFileSelect(input) {
            if (input.files && input.files[0]) {
                $('#fileName').text('📎 ' + input.files[0].name);
            }
        }

        function onDragOver(e) { e.preventDefault(); $('#fileDrop').addClass('dragover'); }
        function onDragLeave(e) { $('#fileDrop').removeClass('dragover'); }
        function onDrop(e) {
            e.preventDefault();
            $('#fileDrop').removeClass('dragover');
            var files = e.dataTransfer.files;
            if (files.length > 0) {
                document.getElementById('fileInput').files = files;
                $('#fileName').text('📎 ' + files[0].name);
            }
        }

        // ---- Submit Document ----
        function submitDocument() {
            var docName = $('#docName').val().trim();
            var cat     = $('#catInput').val().trim();
            var docType = $('#docType').val().trim();
            var file    = document.getElementById('fileInput').files[0];

            if (!docName) { showToast('Please enter document name.', 'error'); return; }
            if (!cat)     { showToast('Please enter or select a category.', 'error'); return; }
            if (!file)    { showToast('Please select a file to upload.', 'error'); return; }

            // Show loader
            $('#submitTxt').hide();
            $('#submitSpinner').show();

            var formData = new FormData();
            formData.append('masterDocumentName', docName);
            formData.append('topic', cat);
            formData.append('documentType', docType || 'General');
            formData.append('file', file);
            formData.append('__RequestVerificationToken', $('input[name="__RequestVerificationToken"]').val());

            $.ajax({
                url: '@Url.Action("AddDocument", "Document")',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function (res) {
                    $('#submitTxt').show();
                    $('#submitSpinner').hide();
                    if (res.success) {
                        showToast(res.message, 'success');
                        closeModal();
                        loadDocuments($('#searchInput').val().trim());
                    } else {
                        showToast(res.message, 'error');
                    }
                },
                error: function () {
                    $('#submitTxt').show();
                    $('#submitSpinner').hide();
                    showToast('Upload failed. Please try again.', 'error');
                }
            });
        }

        // ---- View Document ----
              function viewDoc(id, docType) {
            var ext = (docType || '').toLowerCase();
            var previewable = ['.pdf', '.jpg', '.jpeg', '.png', '.gif', '.bmp', '.webp'];
            var isPreviewable = previewable.some(function(e) { return ext.includes(e); });

            var url = '@Url.Action("ViewDocument", "Document")/' + id;

            if (isPreviewable) {
                // Nayi tab mein preview karo
                window.open(url, '_blank');
            } else {
                // Direct download
                window.location.href = url;
            }
        }

        // ---- Delete Document ----
        function deleteDoc(id) {
            if (!confirm('Are you sure you want to delete this document?')) return;
            $.ajax({
                url: '@Url.Action("DeleteDocument", "Document")',
                type: 'POST',
                data: { id: id, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() },
                success: function (res) {
                    if (res.success) {
                        showToast(res.message, 'success');
                        loadDocuments($('#searchInput').val().trim());
                    } else {
                        showToast(res.message, 'error');
                    }
                }
            });
        }

        // ---- Modal ----
        function openModal() {
            $('#addModal').addClass('show');
            $('body').css('overflow', 'hidden');
            // Add AntiForgery token hidden field for AJAX
            if ($('input[name="__RequestVerificationToken"]').length === 0) {
                $('body').append('@Html.AntiForgeryToken()');
            }
        }

        function closeModal() {
            $('#addModal').removeClass('show');
            $('body').css('overflow', '');
            $('#docName').val('');
            $('#catInput').val('');
            $('#docType').val('');
            $('#fileName').text('');
            document.getElementById('fileInput').value = '';
        }

        // ---- Sidebar (mobile) ----
        function toggleSidebar() {
            $('#sidebar').toggleClass('open');
            $('#sidebarOverlay').toggleClass('show');
        }

        function closeSidebar() {
            $('#sidebar').removeClass('open');
            $('#sidebarOverlay').removeClass('show');
        }

        // ---- Toast ----
        function showToast(msg, type) {
            var icon = type === 'success' ? '✅' : '❌';
            var t = $('<div class="toast ' + (type || '') + '">' + icon + ' ' + msg + '</div>');
            $('#toastWrap').append(t);
            setTimeout(function () { t.fadeOut(400, function () { t.remove(); }); }, 3500);
        }



        //QR SCRIP
        // ---- Download ----
function downloadDoc(id) {
    window.location.href = '@Url.Action("DownloadDocument", "Document")/' + id;
}

// ---- QR Code ----
function openQR(id) {
    $.ajax({
        url: '@Url.Action("GetDocumentForQR", "Document")/' + id,
        type: 'GET',
        success: function (res) {
            if (!res.success) { showToast('Failed to generate QR.', 'error'); return; }

            $('#qrImage').attr('src', 'data:image/png;base64,' + res.qrBase64);
            $('#qrDocName').text(res.documentName || '-');
            $('#qrCategory').text(res.category || '-');
            $('#qrDate').text(res.date || '-');
            $('#qrUploadedBy').text(res.uploadedBy || '-');
            $('#qrModal').addClass('show');
        },
        error: function () { showToast('Failed to generate QR.', 'error'); }
    });
}

function closeQR() {
    $('#qrModal').removeClass('show');
}

// ---- Print QR Card ----
function printQR() {
