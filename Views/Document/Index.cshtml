            </style>
        </head>
        <body>
            <div class="card">${cardHtml}</div>
            <script>
                window.onload = function() {
                    window.print();
                    window.close();
                }
            </scr` + `ipt>
        </body>
        </html>
    `);
    win.document.close();
}
